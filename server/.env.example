# ===== 服务 =====
NODE_ENV=development
PORT=4000
# 前端来源，逗号分隔，生产禁用通配符
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ===== 安全密钥（务必自行生成，勿提交真实值） =====
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_hex_32bytes
JWT_REFRESH_SECRET=replace_with_another_random_hex_32bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== 数据库 =====
DATABASE_PATH=./data/attendance.db

# ===== 微信网页 OAuth（开放平台网站应用） =====
# 在 https://open.weixin.qq.com 创建「网站应用」，通过认证后获取 AppID/AppSecret
WECHAT_APP_ID=your_wechat_open_platform_appid
WECHAT_APP_SECRET=your_wechat_open_platform_appsecret
# 授权回调地址：必须指向【前端】的 /login 页面，且域名需在开放平台「授权回调域名」中登记。
# 微信授权后会跳回此地址并带上 ?code=xxx&state=yyy，前端据此调用 /api/auth/login-by-code。
# 注意：不能填 localhost/内网地址，必须是公网已备案域名（可在微信内访问）。
WECHAT_REDIRECT_URI=https://your-domain.com/login
# 开发模式：为 true 时用模拟身份登录，跳过真实微信回调，便于本地联调；生产必须为 false
AUTH_DEV_MODE=false
AUTH_DEV_OPENID=dev-openid-001

# ===== 电脑端账号密码登录（与微信登录并存） =====
# 关闭后登录页不再显示账号登录；只做电脑端时也可不配置上面的微信凭证
PASSWORD_LOGIN_ENABLED=true

# ===== 考勤授权与位置规则 =====
# 允许上报的半径（米），超出视为异常考勤
ATTENDANCE_RADIUS_METERS=500
# 考勤基准点（公司坐标），在此半径内视为正常出勤
OFFICE_LAT=22.5431
OFFICE_LNG=114.0579
# ===== 逆地理编码（腾讯位置服务 WebService，合规白名单） =====
# 在 https://console.amap.com/dev/key/app 创建应用获取 Key（Web服务API 类型）
# 未配置或为占位符时自动跳过地址解析，不影响打卡
AMAP_KEY=Please apply for your own key at AMap Open Platform and replace this placeholder
# 若该 Key 开通了数字签名，填对应私钥；默认无需签名，留空即可
AMAP_SECRET=
# 浏览器 GPS 为 WGS-84，自动转 GCJ-02；若定位源已是火星坐标改为 gcj02
GEO_INPUT_COORD=wgs84
GEO_REVERSE_ENABLED=true

# 工作时段（服务端时区），自动上报只在这些时段内生效，格式 HH:mm
WORK_START_TIME=09:00
WORK_END_TIME=18:00
WORK_DAYS=1,2,3,4,5

# ===== 邮件通知 (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="考勤系统 <noreply@example.com>"
# 考勤事件通知收件人，逗号分隔
ATTENDANCE_MAIL_TO=hr@example.com

# ===== 邮件中继 + 即时触发（Railway Hobby 屏蔽 SMTP 端口时使用） =====
# 开启后邮件由 GitHub Actions 通过 HTTPS 接口代发（见 .github/workflows/mail-relay.yml）
MAIL_RELAY_ENABLED=false
MAIL_RELAY_TOKEN=
# 打卡入队后即时触发一次中继，把延迟从 cron 的 5 分钟降到约 20-60 秒。
# GITHUB_TOKEN 需具备该仓库 Actions 写权限（fine-grained PAT: Actions read+write，或 classic PAT: repo/workflow）。
# 留空则退化为仅 cron 发送，功能不受影响。
GITHUB_TOKEN=
GITHUB_REPO=AZ654/attendance-app
GITHUB_WORKFLOW=mail-relay.yml
GITHUB_REF=master

# ===== 手机号绑定短信验证码 =====
# dev：不真正发短信，验证码在响应中返回并写日志（仅联调用，切勿用于生产）
# tencent：调用腾讯云短信，需配置下面 5 项（短信 SDK 应用 ID / 签名 / 模板 ID / 密钥）
SMS_PROVIDER=dev
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=

# ===== 实名信息加密（用于自愿填写的身份证号等，AES-256-GCM） =====
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=replace_with_32byte_hex_for_aes256gcm
